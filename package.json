{
	"name": "tokendash",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"collect": "node collect/local.ts",
		"pull": "sh collect/pull.sh",
		"prices": "node collect/prices.ts",
		"tokendash": "node collect/index.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && TSGO_BIN=node_modules/.bin/tsrs svelte-check-native --tsconfig ./tsconfig.json",
		"check:slow": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-check-native": "^1.10.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@radix-ui/colors": "^3.0.0"
	},
	"packageManager": "pnpm@12.4.2",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
